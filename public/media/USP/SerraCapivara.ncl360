<ncl360 id="cena">
    <head>
        <!-- caracteristicas de apresentacao -->
        <descriptor id="dhub" region="default.sky" projection="equirectangular" volume="1"/>

    </head>
    
    <body>
    
        <!-- Vídeo já começa no Play -->
		<port component="hub"/>
		
