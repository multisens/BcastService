<!DOCTYPE html>
<html>

<head>
    <style>
        :root {
            --base-size: 1vw;
        }

        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            height: 100%;
            font-family: Verdana;
        }

        .main {
            position: relative;
            width: 100vw;
            height: 100vh;

            >* {
                position: absolute;
                display: block;
                border: none;
            }
        }
    </style>
    <script src="js/aop-bridge.js"></script>
    <script src="js/sepe.js"></script>
    <script>
        async function execute() {
            const sepe = await findSepe();
            if (!sepe) {
                console.error("No SEPE found, exiting.");
                return;
            }

            console.log("Scheduling light effects...");
            document.addEventListener("stream_event", (e) => {
                const event = JSON.parse(e.detail);
                event.effects.forEach(effect => {
                    if (effect.type === "LightType") {
                        console.log("UFF: Sending Color Event to SEPE", effect.description)
                        playLightEffect(sepe, effect.action, effect.color, effect.location)
                    } else if (effect.type === "ScentType") {
                        playScentEffect(sepe, effect.action, effect.intensityValue, effect.location, effect.scent)
                    } else if (effect.type === "WindType") {
                        playWindEffect(sepe, effect.action, effect.intensityValue, effect.location)
                    }
                });
            })

            window.addEventListener('beforeunload', async (e) => {
                console.log("Turning effects off before quitting page.")
                await playLightEffect(sepe, "stop", [0, 0, 0]);
            });
        }
    </script>
</head>

<body>
    <script>
        execute();


    </script>
</body>

</html>