<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Companion</title>
    <style>
        html, body {
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            background: #f0f4f8;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            display: flex;
            flex-direction: column;
        }
        #status-bar {
            padding: 0.4rem 1rem;
            font-size: 0.78rem;
            text-align: center;
            background: #e2e8f0;
            color: #64748b;
            flex-shrink: 0;
        }
        #status-bar.connected { background: #dcfce7; color: #15803d; }
        #status-bar.error     { background: #fee2e2; color: #b91c1c; }

        #waiting {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 1rem;
            color: #64748b;
            font-size: 1.1rem;
            text-align: center;
            padding: 2rem;
        }

        #content-frame {
            flex: 1;
            border: none;
            width: 100%;
            display: none;
        }
    </style>
</head>
<body>
    <div id="status-bar">Conectando...</div>
    <div id="waiting"><span>Aguardando transmissão...</span></div>
    <iframe id="content-frame"></iframe>

    <script>
        const serverHost = window.location.hostname;
        const ccwsBase   = `http://${serverHost}:44642`;
        let ws;

        const statusBar = document.getElementById('status-bar');
        const waiting   = document.getElementById('waiting');
        const frame     = document.getElementById('content-frame');

        function setStatus(msg, cls) {
            statusBar.textContent = msg;
            statusBar.className = cls || '';
        }

        function showFrame(src) {
            waiting.style.display = 'none';
            frame.src = src;
            frame.style.display = 'block';
        }

        function showWaiting(msg) {
            frame.style.display = 'none';
            frame.src = 'about:blank';
            waiting.querySelector('span').textContent = msg || 'Aguardando transmissão...';
            waiting.style.display = 'flex';
        }

        function handleMessage(data) {
            console.log('Mensagem recebida:', data);
            if (data.type === 'replay' && data.value === 'start') {
                showFrame('/webmedia/companion/replay');
            } else if (data.type === 'replay' && data.value === 'stop') {
                showWaiting('Aguardando próxima etapa...');
            } else if (data.type === 'message' && data.value === 'start') {
                showFrame('/webmedia/companion/vote');
            } else if (data.type === 'hello') {
                setStatus('Conectado — aguardando transmissão', 'connected');
            }
        }

        // Relay de votos: vote_menu.ejs envia via window.parent.postMessage
        window.addEventListener('message', (event) => {
            const msg = event.data;
            if (msg && msg.type === 'iframe-message' && msg.payload) {
                if (ws && ws.readyState === WebSocket.OPEN) {
                    ws.send(JSON.stringify(msg.payload));
                    console.log('Voto enviado ao TV:', msg.payload);
                }
            }
        });

        async function registerAndConnect() {
            setStatus('Conectando...', '');
            try {
                const resp = await fetch(`${ccwsBase}/tv3/remote-device`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ deviceClass: 'companion', supportedTypes: ['companion'] })
                });
                if (!resp.ok) throw new Error(`Registro falhou: ${resp.status}`);
                const { url } = await resp.json();
                const wsUrl = url.replace('localhost', serverHost);

                ws = new WebSocket(wsUrl);

                ws.onopen = () => {
                    setStatus('Conectado — aguardando transmissão', 'connected');
                    console.log('Companion conectado:', wsUrl);
                };
                ws.onmessage = (evt) => {
                    try { handleMessage(JSON.parse(evt.data)); } catch (_) {}
                };
                ws.onclose = () => {
                    setStatus('Desconectado. Reconectando...', 'error');
                    setTimeout(registerAndConnect, 3000);
                };
                ws.onerror = (err) => console.error('WebSocket erro:', err);
            } catch (err) {
                setStatus('Erro: ' + err.message, 'error');
                setTimeout(registerAndConnect, 5000);
            }
        }

        registerAndConnect();
    </script>
</body>
</html>
