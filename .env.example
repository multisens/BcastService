# Defaults pra rodar BCast. Em container, a imagem nao leva este arquivo: o
# docker-compose.yml do TV30 (service `bcast`) define PORT, MQTT_HOST,
# BCAST_HOSTNAME, BSID, EDUPLAY_SID, UFF_SID, WEBMEDIA_SID e os caminhos do
# webmedia, e as demais ficam no padrao do codigo.
#
# Required (server falha no boot se faltar): MQTT_HOST, BCAST_HOSTNAME

# Porta do servidor HTTP. Default = 8081.
PORT=8081

# [REQUIRED] Hostname do broker MQTT. Em container = nome do service ('mosquitto').
# Fora de container = localhost (broker rodando no host).
MQTT_HOST=localhost

# [REQUIRED] Hostname usado pra construir bcastEntryPackageUrl na BALD.
# Em container, AoP faz proxy pra esse host — precisa ser o service-name
# (resolve via ginga_net DNS), nao localhost. Fora de container, use 'localhost'.
BCAST_HOSTNAME=bcast

# IDs fixos. Se ausentes, BSID, EDUPLAY_SID, UFF_SID e WEBMEDIA_SID saem novos
# a cada restart (cuid.slug) e criam topicos orfaos retidos no broker; o
# docker-compose.yml do TV30 fixa os quatro. USERS_TEST_SID ja tem padrao fixo
# (urn:tv30:service:users-test). Setar pra valores fixos em producao.
# BSID=tv30-default
# EDUPLAY_SID=urn:tv30:service:eduplay
# UFF_SID=urn:tv30:service:uff
# WEBMEDIA_SID=urn:tv30:service:webmedia
# USERS_TEST_SID=urn:tv30:service:users-test
#
# Porta do servidor de logica do quiz do eduplay, que entra na URL da pagina
# do apresentador (http://<host de BCAST_HOSTNAME>:<porta>). Default = 8082.
# O compose do TV30 nao sobe esse servidor.
# EDUPLAY_LOGIC_PORT=8082

# appId de cada aplicacao na BALD. FIXO por padrao, urn:tv30:app:<modulo>
# (decisao do Luis em 11/10): o AoP tira dele o nome do host proprio da
# aplicacao (P1.3), que assim sobrevive ao reinicio do bcast, junto com o que
# a aplicacao guarda no navegador. O docker-compose.yml do TV30 nao repassa
# estas variaveis: em container vale o padrao.
# EDUPLAY_APP_ID=urn:tv30:app:eduplay
# UFF_APP_ID=urn:tv30:app:uff
# USERS_TEST_APP_ID=urn:tv30:app:users-test
# WEBMEDIA_APP_ID=urn:tv30:app:webmedia

# Logging: ERROR | INFO | DEBUG (default ERROR)
# LOG_LEVEL=ERROR