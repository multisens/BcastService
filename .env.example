# Defaults to run bcast outside a container. In a container the TV30
# docker-compose.yml (service `bcast`) applies; what it does not set keeps
# the default of the code.
#
# Required (the server fails at startup without them): MQTT_HOST,
# BCAST_HOSTNAME.

# Port of the HTTP server. Default 8081.
PORT=8081

# [REQUIRED] Host name of the MQTT broker. In a container, the service name
# ('mosquitto').
MQTT_HOST=localhost

# [REQUIRED] Host name of bcastEntryPackageUrl in the BALD, the target of the
# AoP proxy: in a container, the service name (DNS of ginga_net); outside,
# 'localhost'.
BCAST_HOSTNAME=bcast

# Fixed ids. Without them, BSID and the SIDs are new on every restart
# (cuid.slug) and leave orphan retained topics in the broker. USERS_TEST_SID
# already has a fixed default.
# BSID=tv30-default
# EDUPLAY_SID=urn:tv30:service:eduplay
# UFF_SID=urn:tv30:service:uff
# WEBMEDIA_SID=urn:tv30:service:webmedia
# USERS_TEST_SID=urn:tv30:service:users-test
#
# Port of the logic server of the eduplay quiz (URL of the presenter page).
# Default 8082. The TV30 compose does not start this server.
# EDUPLAY_LOGIC_PORT=8082

# appId of each application in the BALD (default urn:tv30:app:<module>). The
# AoP derives from it the own host of the application.
# EDUPLAY_APP_ID=urn:tv30:app:eduplay
# UFF_APP_ID=urn:tv30:app:uff
# USERS_TEST_APP_ID=urn:tv30:app:users-test
# WEBMEDIA_APP_ID=urn:tv30:app:webmedia

# Logging: ERROR | INFO | DEBUG (default ERROR).
# LOG_LEVEL=ERROR