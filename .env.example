# Defaults pra rodar o bcast fora de container. Em container vale o
# docker-compose.yml do TV30 (service `bcast`); o que ele nao define fica no
# padrao do codigo.
#
# Required (server falha no boot se faltar): MQTT_HOST, BCAST_HOSTNAME

# Porta do servidor HTTP. Default = 8081.
PORT=8081

# [REQUIRED] Hostname do broker MQTT. Em container = nome do service ('mosquitto').
MQTT_HOST=localhost

# [REQUIRED] Hostname de bcastEntryPackageUrl na BALD. O AoP faz proxy pra esse
# host: em container, o service-name (DNS da ginga_net); fora, 'localhost'.
BCAST_HOSTNAME=bcast

# IDs fixos. Sem eles, BSID e os SIDs saem novos a cada restart (cuid.slug) e
# deixam topicos orfaos retidos no broker. USERS_TEST_SID ja tem padrao fixo.
# BSID=tv30-default
# EDUPLAY_SID=urn:tv30:service:eduplay
# UFF_SID=urn:tv30:service:uff
# WEBMEDIA_SID=urn:tv30:service:webmedia
# USERS_TEST_SID=urn:tv30:service:users-test
#
# Porta do servidor de logica do quiz do eduplay (URL da pagina do
# apresentador). Default = 8082. O compose do TV30 nao sobe esse servidor.
# EDUPLAY_LOGIC_PORT=8082

# appId de cada aplicacao na BALD (padrao urn:tv30:app:<modulo>). O AoP tira
# dele o host proprio da aplicacao: fixo, o host e o que a aplicacao guarda no
# navegador sobrevivem ao reinicio do bcast.
# EDUPLAY_APP_ID=urn:tv30:app:eduplay
# UFF_APP_ID=urn:tv30:app:uff
# USERS_TEST_APP_ID=urn:tv30:app:users-test
# WEBMEDIA_APP_ID=urn:tv30:app:webmedia

# Logging: ERROR | INFO | DEBUG (default ERROR)
# LOG_LEVEL=ERROR